#include "resource.h"
#include <windows.h>

IDI_APP ICON "realtone_killswitch.ico"
IDI_GITHUB ICON "github.ico"
IDI_KOFI ICON "kofi.ico"

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION DAYAAH_VERSION_NUM
PRODUCTVERSION DAYAAH_VERSION_NUM
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040A04B0"
        BEGIN
            VALUE "CompanyName", "Dayaah\0"
            VALUE "FileDescription", "Killswitch momentaneo para Rocksmith Real Tone Cable\0"
            VALUE "FileVersion", DAYAAH_VERSION_TEXT
            VALUE "InternalName", "DayaahRealToneKillswitch\0"
            VALUE "OriginalFilename", "Dayaah_RealTone_Killswitch.exe\0"
            VALUE "ProductName", "Dayaah RealTone Killswitch\0"
            VALUE "ProductVersion", DAYAAH_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040A, 1200
    END
END

